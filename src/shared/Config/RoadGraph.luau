--!strict
-- Voltage County's one road graph (PLAN.md §5; docs/phase-2-contracts.md, "Data"). It drives the greybox road
-- build (Dev/MapBuilder), routing and GPS (Road/Graph, Road/Pathfind), job routes and NPC traffic later, and the
-- AutoDriver route tests.
--
-- Coordinates: X is east, north is -Z, Y is up, and everything sits within World.mapHalfExtent of the origin. A
-- node's position is the road surface top there: y = 0.2 on flat ground (a 1-stud slab whose top is 0.2 above
-- the ground), the mesa face or top on the Mesa's trails (MapLayout.mesas: the trails climb straight up planar
-- faces, so a straight edge between two trail nodes lies exactly on the ground), and up to 20.2 on the Cedar Lake
-- Bridge, which stands on supports.
--
-- Every edge is a straight, two-way stretch of road between two nodes; curves are chains of short edges (15
-- degrees per node on streets, 5 on the County Loop). An edge's width is lanes * World.laneWidth +
-- 2 * styles[kind].shoulder; sidewalks are extra, outside that. Edge rows only spell out what differs from
-- their kind's defaults (KIND_DEFAULTS).
--
-- tests/RoadGraph.spec checks every rule from the contract against these numbers (limits in `rules`): unique
-- node ids, every edge's ends exist, no duplicate edges, one connected graph; edges never cross except at a
-- shared node (a bridge may pass over a road with `rules.bridgeClearance` studs between them); grades and edge
-- lengths within limits; the County Loop a closed cycle of highway edges; and the MapLayout locations within
-- `roadReach` of a road, off the carriageway. The layout was planned with a script and checked against the
-- same rules, but the rows are plain data: edit them by hand and the spec catches a broken rule.

export type Kind = "highway" | "arterial" | "street" | "ramp" | "bridge" | "dirt"
export type Surface = "asphalt" | "dirt" | "concrete"

export type Node = {
	id: string,
	position: Vector3, -- road surface top at the node
	zone: string, -- a MapLayout zone id
}

export type Edge = {
	from: string, -- node ids; every edge is two-way
	to: string,
	lanes: number, -- total lanes, both directions
	speedLimitMph: number,
	surface: Surface,
	kind: Kind,
}

export type Style = {
	shoulder: number, -- extra width each side beyond the lanes, studs
	sidewalk: number, -- sidewalk width each side (0 = none)
	color: Color3,
	lineColor: Color3,
}

-- The limits the layout keeps to (tests/RoadGraph.spec).
export type Rules = {
	maxGrade: number, -- rise / run on every road...
	maxTrailGrade: number, -- ...except dirt trails
	maxEdgeLength: number, -- studs (one part is at most 2,048)
	bridgeClearance: number, -- studs between a bridge deck and the road or water under it
	surfaceAboveGround: number, -- a road's surface top sits this far above the ground under it
	minJunctionAngle: number, -- degrees between two roads leaving the same node
	roadGap: number, -- studs between the sidewalks (or edges) of two roads that do not meet
}

export type RoadGraph = {
	nodes: { Node },
	edges: { Edge },
	styles: { [Kind]: Style },
	roadReach: number,
	loopNodeIds: { string },
	rules: Rules,
	spatialCellSize: number,
	onRoadBelow: number,
	onRoadAbove: number,
	loopZoneKinds: { Kind },
	loopZoneMargin: number,
}

type EdgeOptions = { lanes: number?, speedLimitMph: number?, surface: Surface? }

-- What an edge of each kind has unless its row says otherwise.
local KIND_DEFAULTS: { [Kind]: { lanes: number, speedLimitMph: number, surface: Surface } } = {
	highway = { lanes = 4, speedLimitMph = 70, surface = "asphalt" },
	arterial = { lanes = 4, speedLimitMph = 45, surface = "asphalt" },
	street = { lanes = 2, speedLimitMph = 30, surface = "asphalt" },
	ramp = { lanes = 2, speedLimitMph = 40, surface = "asphalt" },
	bridge = { lanes = 4, speedLimitMph = 45, surface = "concrete" },
	dirt = { lanes = 2, speedLimitMph = 35, surface = "dirt" },
}

local function node(id: string, x: number, y: number, z: number, zone: string): Node
	return { id = id, position = Vector3.new(x, y, z), zone = zone }
end

local function edge(from: string, to: string, kind: Kind, options: EdgeOptions?): Edge
	local defaults = KIND_DEFAULTS[kind]
	local given: EdgeOptions = options or {}
	return {
		from = from,
		to = to,
		lanes = given.lanes or defaults.lanes,
		speedLimitMph = given.speedLimitMph or defaults.speedLimitMph,
		surface = given.surface or defaults.surface,
		kind = kind,
	}
end

